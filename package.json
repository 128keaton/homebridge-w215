{
    "name": "homebridge-w215-kb",
    "displayName": "D-Link W215 Smart Plug",
    "version": "1.0.7",
    "description": "Homebridge plugin for the D-Link DSP-W215 smart plug (switch, temperature and power meter)",
    "type": "module",
    "main": "dist/accessory.js",
    "files": [
        "dist",
        "config.schema.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "watch": "tsc --watch --preserveWatchOutput",
        "build": "rimraf ./dist && tsc",
        "test": "rimraf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
        "prepublishOnly": "npm run lint && npm run build && npm test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@homebridge/hap-nodejs": "^2.3.0",
        "@types/node": "^22.0.0",
        "homebridge": "^2.5.0",
        "rimraf": "^6.1.4",
        "typescript": "~5.1.6"
    },
    "author": "Keaton Burleson",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.12.0",
        "homebridge": "^1.6.0 || ^2.0.0-beta.0"
    },
    "homepage": "https://github.com/128keaton/homebridge-w215#readme",
    "bugs": {
        "url": "https://github.com/128keaton/homebridge-w215/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/128keaton/homebridge-w215.git"
    },
    "keywords": [
        "homebridge-plugin",
        "D-Link",
        "dlink",
        "w215",
        "w216b",
        "dsp"
    ]
}
